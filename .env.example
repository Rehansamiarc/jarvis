# =====================================================================================
# JARVIS — environment contract
# Copy to .env.local for local development. Set the same names in Vercel → Settings →
# Environment Variables for production. NEVER commit real values.
#
# Legend:
#   [REQUIRED]  app cannot function without it
#   [REQUIRED*] required for the named feature only
#   [OPTIONAL]  nice-to-have; feature degrades gracefully when absent
# =====================================================================================

# ------------------------------------- Core app -------------------------------------
# Public origin of the deployment. Used for OAuth redirect construction and cookies.
# Local:  http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random 32+ char string. Encrypts integration tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Shared secret for scheduled sweeps. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
# Also used by any external scheduler you point at /api/cron/*.
CRON_SECRET=

# ------------------------------------ Supabase --------------------------------------
# [REQUIRED] Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [REQUIRED] Server-only. Service role bypasses RLS — must NEVER be prefixed NEXT_PUBLIC_
# and must never be imported by a client component.
SUPABASE_SERVICE_ROLE_KEY=

# [REQUIRED for `npm run db:migrate`] Supabase CLI personal access token.
# https://supabase.com/dashboard/account/tokens
# NOTE: a *scoped* token must include the `database_write` permission, otherwise
# `supabase db push` fails with "Missing required permission(s): database_write".
# Either grant that permission or set SUPABASE_DB_PASSWORD below instead — the CLI
# needs only one of the two.
SUPABASE_ACCESS_TOKEN=

# [REQUIRED before the first `npm run db:migrate`] Project reference from the dashboard URL:
# https://supabase.com/dashboard/project/<PROJECT_REF>
SUPABASE_PROJECT_REF=

# [ALTERNATIVE to a write-capable access token] Your database password.
# Supabase dashboard → Project Settings → Database → Database password.
# Used only by `supabase db push`; never read by the application at runtime.
SUPABASE_DB_PASSWORD=

# ------------------------------------ AI models -------------------------------------
# Any ONE of the providers below is enough to run JARVIS — three of them are free and
# no credit card is required. The server picks whichever keys it finds and falls back
# automatically when one is rate-limited or unavailable (src/lib/ai/providers.ts).
#
# FREE — Google Gemini (recommended starting point)
#   https://aistudio.google.com/apikey  → copy the key, no billing needed.
#   Free tier is model/project dependent: read your quota in AI Studio.
#   NOTE: on the unpaid tier Google may use prompts to improve its products. Route
#   genuinely private work elsewhere if that matters to you.
GOOGLE_API_KEY=
# Alias accepted if you already use the GEMINI_* name.
GEMINI_API_KEY=
#
# FREE — Groq (very fast, tool-capable models, ~30 RPM / 1000 requests a day per model)
#   https://console.groq.com/keys  → no embeddings endpoint, so this cannot serve the
#   knowledge base on its own; it is a chat fallback.
GROQ_API_KEY=
#
# FREE — Ollama, local and private: nothing leaves your machine, no quota at all.
#   Install https://ollama.com, then:  ollama pull qwen3:8b   (tools + chat)
#                                     ollama pull nomic-embed-text (knowledge base)
#   Only probed when this variable is set. 8B models want ~8-12 GB of RAM.
#OLLAMA_BASE_URL=http://localhost:11434/v1
#
# PAID — OpenAI, optional. Adding this key is enough to bring it into the fallback chain.
OPENAI_API_KEY=
# Optional overrides for any OpenAI-compatible endpoint (OpenRouter, Together, ...).
OPENAI_BASE_URL=https://api.openai.com/v1

# Model overrides. Leave empty to use the platform defaults from
# supabase/migrations/20261026000008_free_provider_defaults.sql (Gemini free tier).
# If you set a model here, JARVIS infers the vendor from the name (gemini-* → Google,
# qwen/* and gpt-oss-* → Groq, qwen3:8b → Ollama).
JARVIS_MODEL_PRIMARY=
JARVIS_MODEL_CODING=
JARVIS_MODEL_RESEARCH=
JARVIS_MODEL_SUMMARY=
JARVIS_MODEL_VISION=
JARVIS_MODEL_SPEECH=
# Embedding model for the knowledge base. The dimension must match the vector columns:
#   Google gemini-embedding-001 → 1536 (default, no migration needed)
#   Ollama  nomic-embed-text     → 768  (set JARVIS_EMBEDDING_DIM=768 and widen the columns)
JARVIS_EMBEDDING_MODEL=
JARVIS_EMBEDDING_DIM=1536

# ---------------------------------- Google OAuth ------------------------------------
# [REQUIRED*] YouTube + Gmail. Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI (production):
#   https://your-app.vercel.app/api/oauth/google/callback
# Authorized redirect URI (local):
#   http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restricts JARVIS to a single Google account (recommended for a personal assistant).
#GOOGLE_HOSTED_DOMAIN=

# ------------------------------------ WordPress -------------------------------------
# [REQUIRED*] WordPress → Users → Profile → Application Passwords.
# Site base URL, e.g. https://example.com (no trailing slash). Server-side only.
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ------------------------------- Search / web tools ---------------------------------
# [OPTIONAL] Server-side web search used by the `web_search` tool.
# https://serper.dev  (free tier available)
SERPER_API_KEY=

# ------------------------------ Notification channels --------------------------------
# [OPTIONAL] Email fallback for notifications when no Gmail connection exists.
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="JARVIS <onboarding@resend.dev>"

# ----------------------------------- Deployment --------------------------------------
# [OPTIONAL] Vercel CLI/API token, used for scripted `vercel deploy` only (start with
# `nv`/`vercel_`). https://vercel.com/account/tokens
# A literal placeholder value is worse than nothing: it makes an automated deploy look
# attempted when it cannot authenticate, so leave it empty until you have a real token.
VERCEL_TOKEN=

# Populated automatically by Vercel. Do not set manually.
VERCEL_URL=
VERCEL_ENV=
