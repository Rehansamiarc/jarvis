# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every local .env is secret; the template is committed on purpose
.env*
!.env.example

# supabase CLI scratch state (link metadata, pooler URL) — never commit
/supabase/.temp/

# vercel
.vercel

# agent/tool state
.freebuff

# typescript
*.tsbuildinfo
next-env.d.ts
/freebuff-sites-build/
/.open-next/
/.wrangler/
# regenerated by `sites_prepare_next` on every publish
/freebuff.open-next.config.ts
/freebuff.wrangler.jsonc

# windows desktop app (built by `npm run desktop:build`)
/desktop/dist/
/desktop/*.log
